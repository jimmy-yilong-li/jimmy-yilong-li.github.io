---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { formatDate } from '../lib/content.mjs';
import posts from '../data/blog.json';
const { frontmatter, headings: markdownHeadings } = Astro.props;
const headings = markdownHeadings.filter((heading: any) => heading.depth === 2);
const relatedPost = posts.find(post => post.slug === frontmatter.relatedSlug);
---
<BaseLayout title={`${frontmatter.title} | Yilong Li`} description={frontmatter.summary} image={frontmatter.cover}>
  <div class="shell">
    <header class="work-header blog-article-header"><a class="back-link" href="/blog/"><Icon name="back" size={16} />Field notes</a><p class="eyebrow">Systems note / {formatDate(String(frontmatter.date).slice(0, 10), true)} / {frontmatter.minutes} min read</p><h1>{frontmatter.title}</h1><p class="work-summary">{frontmatter.summary}</p><p class="work-authors">Yilong Li</p></header>
    <figure id={frontmatter.coverId} class:list={['blog-hero-figure', { 'blog-hero-figure--responsive': frontmatter.coverMobile }]}>
      <picture>
        {frontmatter.coverMobile && <source media="(max-width: 600px)" srcset={frontmatter.coverMobile} width="480" height="720" />}
        <img src={frontmatter.cover} alt={frontmatter.coverAlt} width="900" height="560" fetchpriority="high" />
      </picture>
      <figcaption>{frontmatter.coverCaption}</figcaption>
    </figure>
    <div class="article-layout">
      <article class="prose blog-prose">
        <slot />
        {relatedPost && <nav class="blog-related-note" aria-label="Related article"><p class="eyebrow">Also in these notes</p><a href={`/blog/${relatedPost.slug}/`}>{relatedPost.title}<Icon name="arrow" size={18} /></a></nav>}
      </article>
      <aside class="contents-nav" aria-label="On this page"><p>On this page</p><ol>{headings.map((heading: any) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol><a class="contents-all" href="/blog/">All field notes <Icon name="diagonal" size={14} /></a></aside>
    </div>
  </div>
</BaseLayout>
