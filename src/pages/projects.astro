---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ResourceLinks from '../components/ResourceLinks.astro';
import { works } from '../data/works';
import { displayImage } from '../lib/content.mjs';
const projects = ['nanomind', 'virgile', 'medusa'].map(slug => works.find(work => work.slug === slug)!);
---
<BaseLayout title="Projects | Yilong Li" description="Explore NanoMind local multimodal inference, Virgile on-device agents, and MEDUSA/mmPupil wireless sensing.">
  <div class="shell">
    <header class="page-heading reveal"><p class="eyebrow">From idea to working system</p><h1>Projects<span class="title-dot">.</span></h1><p>Three connected directions.<br />Local inference, personal agents, and wireless human sensing.</p></header>
    <div class="project-list">
      {projects.map((work, index) => <article id={work.slug === 'medusa' ? 'wireless-sensing' : work.slug} class="project-feature">
        <a class:list={['project-feature-image', `work-cover--${work.slug}`]} href={`/work/${work.slug}/`}><img src={displayImage(work.cover)} alt={work.coverAlt} width="900" height="560" style={`object-fit:${work.coverFit ?? 'cover'}`} loading="lazy" /><span class="cover-arrow"><Icon name="diagonal" size={22} /></span></a>
        <div class="project-feature-copy"><p class="eyebrow">{String(index + 1).padStart(2, '0')} / {work.category}</p><h2>{work.slug === 'medusa' ? 'Wireless human sensing' : work.name}</h2><p class="project-lead">{work.summary}</p>
          {work.slug === 'nanomind' && <p>Hardware prototypes, accelerator-aware runtimes, and efficient model execution. Related work includes PalmBench's measurements of compressed LLMs on mobile platforms.</p>}
          {work.slug === 'virgile' && <p>Persistent visual memory on edge hardware. Re-Mind explores privacy-preserving personal memory; <a href="/work/cppo/">CPPO</a> and <a href="/work/ember/">EMBER</a> provide related work on reasoning and memory policies.</p>}
          {work.slug === 'medusa' && <p>MEDUSA's distributed MIMO radar and mmPupil's glasses-mounted 60 GHz radar bring sensing into indoor, hospital, and everyday environments.</p>}
          <a class="text-link" href={`/work/${work.slug}/`}>Explore {work.name} <Icon name="arrow" size={17} /></a>
          {work.slug === 'medusa' && <ResourceLinks resources={work.resources.filter(resource => resource.label === 'Code')} compact />}
        </div>
      </article>)}
    </div>
    <section class="mmpupil-context" aria-labelledby="mmpupil-heading">
      <div><p class="eyebrow">Within wireless sensing / Under review</p><h2 id="mmpupil-heading">mmPupil</h2><p>Pupil sensing with a glasses-mounted mmWave radar and front-facing illumination context. The system separates light-driven pupil changes from cognitive signals. The paper is under review.</p></div>
      <figure><img src={displayImage('/images/mmpupil-system.png')} alt="mmPupil wearable radar platform and illumination compensation pipeline" width="1600" height="582" loading="lazy" /><figcaption>Wearable radar platform and illumination compensation pipeline.</figcaption></figure>
    </section>
  </div>
</BaseLayout>
