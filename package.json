{
  "name": "yilong-research-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "prebuild": "node scripts/prepare-public-assets.mjs",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "import:content": "node scripts/import-content.mjs",
    "prepare:assets": "node scripts/prepare-public-assets.mjs",
    "assets": "node scripts/extract-nanomind-figures.mjs && node scripts/extract-ember-figures.mjs && node scripts/optimize-images.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "astro": "7.3.8",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3"
  }
}
